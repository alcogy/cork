# Local development secrets — never commit .dev.vars
# Copy this file to .dev.vars and fill in your values.
# Wrangler reads .dev.vars automatically when running `bun dev`

# Email provider for account notifications: resend | ses | smtp
EMAIL_PROVIDER=resend

# Sender address (must be verified in your chosen provider)
EMAIL_FROM=noreply@example.com

# Admin alert recipient (fallback if not set in settings table)
ALERT_EMAIL_TO=

# Resend API key — obtain from https://resend.com
RESEND_API_KEY=

# AWS SES credentials (only needed if EMAIL_PROVIDER=ses)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1

# SMTP relay credentials (only needed if EMAIL_PROVIDER=smtp)
# SMTP_API_URL=
# SMTP_API_KEY=
